{
  "name": "glaceon-terminal",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "node scripts/fix-node-pty-permissions.mjs",
    "dev": "pnpm --filter @glaceon/desktop dev",
    "build": "pnpm --filter @glaceon/desktop build",
    "package": "pnpm --filter @glaceon/desktop package",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm --filter @glaceon/desktop e2e",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm e2e",
    "e2e:packaged": "pnpm --filter @glaceon/desktop e2e:packaged",
    "bench": "pnpm --filter @glaceon/desktop bench"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "happy-dom": "^20.0.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
